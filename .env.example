# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
# `.env` is gitignored — never commit it.

# --- Required ---------------------------------------------------------------
# Free, no credit card: https://console.groq.com -> API Keys -> Create
GROQ_API_KEY=your_groq_api_key

# --- Broadcast target (pick ONE, comment out the rest) ----------------------
# Every target is the same FFmpeg push — switching is a .env change only.

# Local MediaMTX (default, zero setup — watch http://localhost:8888/radio):
STREAM_URL=rtmp://localhost:1935
STREAM_KEY=radio

# Twitch (needs 2FA enabled first: twitch.tv/settings/security):
#STREAM_URL=rtmp://live.twitch.tv/app
#STREAM_KEY=your_twitch_stream_key

# YouTube (needs 24h live-streaming activation on the channel):
#STREAM_URL=rtmps://a.rtmp.youtube.com:443/live2
#STREAM_KEY=your_youtube_stream_key

# --- Optional overrides (defaults shown) ------------------------------------
#GROQ_MODEL=openai/gpt-oss-120b
#TTS_VOICE=en-US-AndrewMultilingualNeural
