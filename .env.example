# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
# `.env` is gitignored — never commit it.

# --- Required ---------------------------------------------------------------
# Free, no credit card: https://console.groq.com -> API Keys -> Create
GROQ_API_KEY=your_groq_api_key

# --- Broadcast Targets ------------------------------------------------------
# Option A: Dual Simulcast (Streams live to BOTH YouTube + Twitch simultaneously)
YOUTUBE_STREAM_KEY=your_youtube_stream_key
TWITCH_STREAM_KEY=your_twitch_stream_key

# Option B: Single Target fallback
#STREAM_URL=rtmps://a.rtmp.youtube.com:443/live2
#STREAM_KEY=your_stream_key

# --- Optional Overrides (defaults shown) ------------------------------------
#GROQ_MODEL=openai/gpt-oss-120b
#TTS_VOICE=en-US-AndrewMultilingualNeural
